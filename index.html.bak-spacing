<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#151513">
<meta name="description" content="ЗАКЛАД. — концепт студії відкриття ресторанів, кав’ярень і стрітфуду під ключ по всій Україні. 20+ проєктів, досвід із 2012 року.">
<title>ЗАКЛАД. — Відкриваємо заклади під ключ</title><link rel="icon" href="assets/logo.svg" type="image/svg+xml">
<style>
:root{--orange:#f35022;--orange-light:#ff7145;--coal:#151513;--cream:#f3eee4;--cream2:#ded9cb;--muted:#928f86;--line:#383833}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:78px}body{margin:0;background:var(--coal);color:var(--cream);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}body.menu-open{overflow:hidden}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #ffbd8d;outline-offset:4px}img{max-width:100%;display:block}svg{display:block}.wrap{max-width:1480px;margin:auto;padding-left:clamp(20px,4vw,68px);padding-right:clamp(20px,4vw,68px)}.eyebrow{font-size:12px;letter-spacing:.24em;text-transform:uppercase;font-weight:800}.orange{color:var(--orange-light)}.display{font-family:Impact,'Arial Black',sans-serif;text-transform:uppercase;font-weight:900;letter-spacing:-.035em;line-height:.92}.nav{height:86px;position:fixed;z-index:100;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(20px,4vw,68px);background:rgba(16,16,15,.94);border-bottom:1px solid #3c3a35;backdrop-filter:blur(18px)}.logo{display:flex;align-items:center;gap:11px;white-space:nowrap;font-family:Impact,'Arial Black',sans-serif;font-size:30px;letter-spacing:.01em}.logo img{width:43px;height:43px}.logo span b{color:var(--orange)}.navlinks{display:flex;align-items:center;gap:clamp(12px,1.8vw,30px);font-size:12px;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.navlinks a{transition:color .2s}.navlinks a:hover{color:var(--orange-light)}.navcta{background:var(--orange);color:#151513;padding:15px 19px;font-size:12px;font-weight:900;letter-spacing:.06em;text-transform:uppercase;display:flex;align-items:center;gap:12px}.navcta:hover,.btn-primary:hover{background:#ff794c}.burger{display:none;width:45px;height:44px;background:transparent;color:var(--cream);border:1px solid #777269;align-items:center;justify-content:center;font-size:25px}.mobilelinks{display:none}.hero{position:relative;min-height:760px;padding-top:86px;overflow:hidden;background:var(--coal)}.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;min-height:670px;gap:0}.hero-copy{padding:88px 0 88px;position:relative;z-index:3}.hero-label{display:flex;align-items:center;gap:13px;margin-bottom:32px;color:var(--cream2)}.hero-label:before{content:'';width:34px;height:8px;background:var(--orange)}.hero h1{font-size:clamp(94px,11.6vw,192px);margin:0 0 30px;max-width:860px}.hero h1 span{display:block}.hero h1 .accent{color:var(--orange)}.hero-desc{font-size:clamp(16px,1.5vw,21px);line-height:1.55;max-width:520px;color:#d3cec4}.actions{display:flex;gap:16px;flex-wrap:wrap;margin-top:32px}.btn-primary,.btn-outline{min-height:56px;padding:18px 24px;font-size:12px;font-weight:900;letter-spacing:.13em;text-transform:uppercase;display:inline-flex;align-items:center;gap:20px;justify-content:space-between;transition:background .2s,transform .2s}.btn-primary{background:var(--orange);color:#141412;border:0}.btn-outline{border:1px solid #8a867c;background:transparent;color:var(--cream)}.btn-outline:hover{border-color:var(--orange);color:var(--orange)}.btn-primary:hover{transform:translateY(-2px)}.hero-visual{position:relative;height:600px;margin:0 -4vw 0 -4vw;align-self:end;min-width:0}.hero-photo{position:absolute;inset:36px 0 60px 12%;width:88%;height:84%;object-fit:cover;object-position:45% center;filter:contrast(1.05)}.photo-cut{position:absolute;top:-1px;left:0;width:32%;height:100%;background:var(--coal);clip-path:polygon(0 0,78% 0,16% 100%,0 100%)}.hero-visual:after{content:'';position:absolute;inset:36px 0 60px 12%;background:linear-gradient(90deg,rgba(21,21,19,.55),transparent 50%);pointer-events:none}.sticker{position:absolute;z-index:3;right:3%;bottom:35px;width:162px;height:162px;border-radius:50%;background:var(--orange);color:var(--coal);display:grid;place-items:center;text-align:center;transform:rotate(12deg);font-weight:900;line-height:1.08;box-shadow:0 0 0 11px var(--coal),0 0 0 12px var(--orange)}.sticker strong{display:block;font:68px/1 Impact,'Arial Black',sans-serif}.hero-stamp{position:absolute;z-index:3;top:20px;right:9%;background:var(--cream);color:var(--coal);font-size:12px;font-weight:900;letter-spacing:.15em;text-transform:uppercase;padding:12px 18px;transform:rotate(5deg)}.ticker{overflow:hidden;white-space:nowrap;background:var(--orange);color:var(--coal);border-top:1px solid var(--coal);border-bottom:1px solid var(--coal);padding:13px 0;font-family:Impact,'Arial Black',sans-serif;letter-spacing:.07em;font-size:23px;text-transform:uppercase}.ticker div{width:max-content;animation:marquee 28s linear infinite}.ticker span{margin:0 21px}.ticker b{font-size:28px}.statrow{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid #393733}.stat{padding:42px 28px 42px 0;border-right:1px solid #393733}.stat:not(:first-child){padding-left:30px}.stat:last-child{border-right:0}.stat strong{font:clamp(36px,4vw,64px)/1 Impact,'Arial Black',sans-serif;display:block}.stat span{font-size:13px;color:#c6c0b4;display:block;margin-top:10px}.sect{padding-top:115px;padding-bottom:115px}.sect-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:46px}.sect-head h2{font-size:clamp(56px,8vw,115px);margin:12px 0 0;line-height:.93}.sect-head p{max-width:360px;line-height:1.6;color:#bdb6a9;margin:0}.about{background:var(--cream);color:var(--coal);overflow:hidden}.about .sect-head p{color:#5d5c57}.about-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(30px,6vw,90px);align-items:center}.about-photo{min-height:610px;position:relative;background:#d7d1c6;overflow:hidden}.about-photo:after{position:absolute;content:'12 / 2026';bottom:24px;left:27px;padding:12px 16px;background:#151513;color:#eee7da;font-weight:900;font-size:13px;letter-spacing:.15em}.about-photo img{width:100%;height:620px;object-fit:cover;object-position:center top}.about-copy h3{font:clamp(55px,6.5vw,100px)/.95 Impact,'Arial Black',sans-serif;letter-spacing:-.03em;text-transform:uppercase;margin:0 0 25px}.about-copy p{font-size:18px;line-height:1.7;max-width:550px}.about-pills{margin-top:30px;display:grid;grid-template-columns:repeat(2,1fr);gap:0;border-top:2px solid var(--coal)}.about-pills div{border-bottom:1px solid #bbb4a7;padding:20px 14px 20px 0;font-size:14px;font-weight:700}.about-pills b{display:block;font:28px Impact,'Arial Black',sans-serif;color:#c74e23;margin-bottom:7px}.project-section{background:#1e1e1b}.project-list{display:grid;grid-template-columns:repeat(12,1fr);gap:22px}.project{position:relative;overflow:hidden;background:#262520;min-height:350px;display:block;cursor:pointer;border:0;text-align:left;color:var(--cream)}.project img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;transition:transform .55s ease,filter .4s}.project:hover img{transform:scale(1.07);filter:saturate(1.15)}.project:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.88),transparent 62%)}.project .pname{position:absolute;z-index:2;left:27px;bottom:25px;right:25px;font:clamp(32px,4vw,60px)/.95 Impact,'Arial Black',sans-serif;text-transform:uppercase;letter-spacing:-.025em}.project .ptag{position:absolute;z-index:2;left:27px;top:24px;background:var(--orange);color:var(--coal);font-size:11px;font-weight:900;letter-spacing:.1em;padding:9px 13px}.project .psub{display:block;font:12px/1.3 Arial,Helvetica,sans-serif;letter-spacing:.04em;font-weight:700;text-transform:none;margin-top:9px;color:#eee5d9}.project:nth-child(1){grid-column:span 7;min-height:500px}.project:nth-child(2){grid-column:span 5;min-height:500px}.project:nth-child(3),.project:nth-child(4){grid-column:span 6}.project-detail{margin-top:25px;display:flex;align-items:flex-start;gap:18px;justify-content:space-between;border-top:1px solid #504e45;padding-top:25px}.project-detail p{color:#bab4a6;line-height:1.6;font-size:15px;max-width:740px;margin:0}.project-detail strong{font-size:12px;letter-spacing:.13em;color:var(--orange-light);white-space:nowrap}.services{background:#f35022;color:#171716}.services .sect-head p{color:#2a261f}.services-list{border-top:3px solid var(--coal)}.service-line{display:grid;grid-template-columns:76px 1fr auto;align-items:center;gap:20px;border-bottom:2px solid var(--coal);padding:25px 0}.service-line .no{font-size:14px;font-weight:900}.service-line h3{font:clamp(27px,3.5vw,48px)/1 Impact,'Arial Black',sans-serif;text-transform:uppercase;margin:0}.service-line .chip{font-size:12px;text-transform:uppercase;letter-spacing:.1em;border:1px solid #171716;padding:12px 14px}.process{background:var(--coal)}.process-items{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #525149}.step{padding:29px 24px 28px 0;position:relative;border-right:1px solid #525149}.step:not(:first-child){padding-left:24px}.step:last-child{border-right:0}.step .num{font:clamp(75px,9vw,145px)/1 Impact,'Arial Black',sans-serif;color:var(--orange)}.step h3{font:26px/1.05 Impact,'Arial Black',sans-serif;text-transform:uppercase;min-height:58px}.step p{color:#aaa398;line-height:1.65;font-size:14px}.work-visual{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:50px}.work-visual figure{margin:0;position:relative;height:400px;overflow:hidden}.work-visual figure img{width:100%;height:100%;object-fit:cover}.work-visual figcaption{position:absolute;left:20px;bottom:20px;background:#161615;color:#fff;padding:10px 15px;font-weight:900;letter-spacing:.12em;font-size:12px}.food{background:var(--cream);color:var(--coal)}.food-images{display:grid;grid-template-columns:1.15fr .8fr 1.15fr;gap:12px;min-height:410px}.food-images img{width:100%;height:410px;object-fit:cover}.food-images img:nth-child(2){object-position:center 42%}.pricing{background:#242420}.calculator{display:grid;grid-template-columns:1.1fr .9fr;gap:30px;background:#151513;border:1px solid #575349;padding:clamp(24px,4vw,60px);align-items:center}.calc h3{font:clamp(40px,5vw,70px)/1 Impact,'Arial Black',sans-serif;text-transform:uppercase;margin:15px 0 24px}.range-label{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:17px;font-size:14px;color:#ded4c3}.range-label strong{font:44px Impact,'Arial Black',sans-serif;color:var(--orange)}input[type=range]{accent-color:var(--orange);width:100%;height:35px;cursor:pointer}.ranges{display:flex;justify-content:space-between;font-size:12px;color:#bcb7a9}.calc-hint{color:#aeaa9f;line-height:1.55;margin:20px 0 0;font-size:13px;max-width:480px}.calc-result{padding:28px;background:var(--cream);color:var(--coal);align-self:stretch;display:flex;flex-direction:column;justify-content:center}.calc-result small{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.calc-result strong{font:clamp(44px,4vw,70px)/1 Impact,'Arial Black',sans-serif;display:block;margin:10px 0 25px}.calc-result .invest{border-top:1px solid #b4aea4;padding-top:22px}.calc-result .invest strong{font-size:clamp(31px,3vw,46px);color:#b74320}.calc-result p{margin:0;color:#605e59;font-size:12px;line-height:1.6}.contact{background:var(--orange);color:var(--coal)}.contact-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:70px;align-items:start}.contact h2{font-size:clamp(75px,10vw,153px);margin:15px 0 24px}.contact p{font-size:18px;line-height:1.6}.form{background:var(--coal);padding:clamp(24px,3.8vw,55px);color:var(--cream)}.form h3{font:36px Impact,'Arial Black',sans-serif;text-transform:uppercase;letter-spacing:.02em;margin:0 0 24px}.field{display:block;margin:0 0 17px}.field span{display:block;margin-bottom:8px;font-size:12px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.field input,.field select,.field textarea{background:#272723;color:var(--cream);border:1px solid #5a574e;width:100%;padding:15px 16px;min-height:52px;outline:0;border-radius:0}.field textarea{min-height:110px;resize:vertical}.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--orange)}.form .btn-primary{width:100%;justify-content:center}.form-note{font-size:12px!important;color:#ada69c!important;margin:16px 0 0!important}.result-message{margin-top:18px;background:#343329;padding:15px;border:1px solid var(--orange);color:#fff7e9;font-size:13px;line-height:1.6;white-space:pre-wrap;display:none}.result-message.show{display:block}.result-message textarea{width:100%;height:140px;background:#171716;color:white;margin-top:10px;border:1px solid #62605a;padding:9px}.footer{padding:28px 0;background:var(--coal);color:#9e998e;border-top:1px solid #494840}.footer-row{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:12px}.footer b{color:var(--cream)}.footer a{text-decoration:underline}.reveal{opacity:0;transform:translateY(25px);transition:opacity .7s ease,transform .7s ease}.reveal.visible{opacity:1;transform:none}.skip{position:absolute;top:-100px;left:10px;background:white;color:black;padding:10px;z-index:999}.skip:focus{top:8px}@keyframes marquee{to{transform:translateX(-50%)}}@media(max-width:1100px){.navlinks{gap:13px}.navlinks a:not(.navcta){font-size:11px}.hero h1{font-size:clamp(83px,11vw,140px)}.hero-grid{grid-template-columns:1fr .85fr}.hero-visual{height:550px}.sect{padding-top:85px;padding-bottom:85px}}@media(max-width:840px){.nav{height:72px}.navlinks{display:none}.burger{display:flex}.mobilelinks{display:flex;position:fixed;z-index:99;inset:72px 0 auto;background:#161614;padding:30px 22px 35px;flex-direction:column;gap:0;transform:translateY(-150%);transition:transform .25s;box-shadow:0 30px 40px #0008}.mobilelinks.open{transform:translateY(0)}.mobilelinks a{padding:15px 3px;border-bottom:1px solid #444;font-weight:800;font-size:19px;text-transform:uppercase}.hero{padding-top:72px;min-height:0}.hero-grid{grid-template-columns:1fr;min-height:0}.hero-copy{padding:72px 0 34px}.hero h1{font-size:clamp(92px,17vw,145px)}.hero-visual{margin:0;height:400px}.hero-photo{inset:0;width:100%;height:100%}.photo-cut,.hero-visual:after{display:none}.hero-stamp{top:16px}.sticker{right:25px;bottom:20px;width:125px;height:125px;box-shadow:0 0 0 7px #151513,0 0 0 8px var(--orange)}.sticker strong{font-size:49px}.statrow{grid-template-columns:1fr 1fr}.stat:nth-child(2){border-right:0}.stat:nth-child(-n+2){border-bottom:1px solid #393733}.stat{padding:25px 18px!important}.about-grid,.calculator,.contact-grid{grid-template-columns:1fr}.about-photo{min-height:auto;max-height:550px}.about-photo img{height:550px}.sect-head{align-items:start;flex-direction:column}.project:nth-child(n){grid-column:span 6;min-height:330px}.process-items{grid-template-columns:repeat(2,1fr)}.step:nth-child(2){border-right:0}.step:nth-child(-n+2){border-bottom:1px solid #525149}.contact-grid{gap:30px}}@media(max-width:580px){.logo{font-size:26px}.logo img{width:37px;height:37px}.hero-copy{padding-top:48px}.hero h1{font-size:clamp(74px,19vw,112px);margin-bottom:22px}.hero-label{font-size:10px;margin-bottom:25px}.hero-desc{font-size:16px}.actions{gap:10px}.btn-primary,.btn-outline{padding:15px 17px;min-height:49px;font-size:11px}.hero-visual{height:320px}.sticker{height:104px;width:104px;font-size:11px}.sticker strong{font-size:42px}.hero-stamp{font-size:10px}.stat span{font-size:12px}.stat strong{font-size:42px}.sect{padding-top:74px;padding-bottom:74px}.sect-head h2{font-size:clamp(57px,13vw,78px)}.about-photo img{height:420px}.about-copy h3{font-size:clamp(55px,12vw,78px)}.about-copy p{font-size:16px}.about-pills{grid-template-columns:1fr}.project-list{gap:12px}.project:nth-child(n){grid-column:span 12;min-height:350px}.project:nth-child(1){min-height:400px}.project-detail{display:block}.project-detail strong{display:block;margin-bottom:10px}.service-line{grid-template-columns:36px 1fr;gap:11px;padding:18px 0}.service-line .chip{grid-column:2;justify-self:start}.service-line h3{font-size:35px}.process-items{grid-template-columns:1fr}.step{border-right:0!important;padding:24px 0!important;border-bottom:1px solid #525149}.step .num{font-size:82px}.step h3{min-height:0;margin:15px 0}.work-visual{grid-template-columns:1fr}.work-visual figure{height:300px}.food-images{grid-template-columns:1fr 1fr;min-height:0}.food-images img{height:290px}.food-images img:nth-child(3){grid-column:span 2;height:275px}.calculator{padding:20px;gap:22px}.calc-result{padding:25px}.contact h2{font-size:clamp(65px,17vw,96px)}.form{padding:25px 20px}.ticker{font-size:19px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}.reveal{opacity:1;transform:none}}
</style><style>
@media(min-width:841px){.hero h1{font-size:clamp(88px,9.4vw,138px)}.hero-copy{padding-top:48px;padding-bottom:52px}.hero-label{margin-bottom:24px}.hero h1{margin-bottom:23px}.actions{margin-top:25px}.hero-grid{min-height:670px}}
@media(max-width:380px){.sect-head h2{font-size:clamp(47px,12.5vw,65px)}.about-copy h3{font-size:43px;letter-spacing:-.05em}.service-line h3{font-size:30px}.contact h2{font-size:clamp(60px,15vw,90px)}}
</style><style>
@media(min-width:841px){.hero h1{font-size:clamp(88px,9.4vw,138px)}.hero-copy{padding-top:48px;padding-bottom:52px}.hero-label{margin-bottom:24px}.hero h1{margin-bottom:23px}.actions{margin-top:25px}.hero-grid{min-height:670px}}
@media(max-width:380px){.sect-head h2{font-size:clamp(47px,12.5vw,65px)}.about-copy h3{font-size:clamp(46px,12vw,65px)}.contact h2{font-size:clamp(60px,15vw,90px)}}
</style><style>
